# Database — either a local SQLite file (dev) or a Turso/libSQL URL (prod).
DATABASE_URL=file:./dev.db
TURSO_AUTH_TOKEN=

# Vercel Blob — admin file uploads.
BLOB_READ_WRITE_TOKEN=

# REQUIRED in production. There are no built-in defaults: if these are unset,
# production env-login is disabled and admin sessions cannot be issued.
# (In `npm run dev` only, admin/admin and a dev secret are used as a fallback.)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 16+ random chars, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=
